# Base de Datos PostgreSQL
POSTGRES_DB=sicv
POSTGRES_USER=sicv
POSTGRES_PASSWORD=sicv_dev_password
DATABASE_URL=postgresql://sicv:sicv_dev_password@db:5432/sicv

# Seguridad y Token Administrativo
ADMIN_API_TOKEN=sicv-admin-local

# Verificación Pública y CORS
PUBLIC_VERIFICATION_BASE_URL=http://localhost:5173/v
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
