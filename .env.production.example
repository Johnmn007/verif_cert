# ====================================================================
# Variables de entorno para PRODUCCIÓN (SICV)
# ====================================================================

# 1. Base de Datos PostgreSQL
POSTGRES_DB=sicv
POSTGRES_USER=sicv_prod_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA
DATABASE_URL=postgresql://sicv_prod_user:CAMBIA_ESTA_CONTRASENA_SEGURA@db:5432/sicv

# 2. Clave Administrativa del Sistema (Guárdala de forma segura)
ADMIN_API_TOKEN=john_#$%2026

# 3. Dominio y Enlaces Oficiales de Verificación (HTTPS)
# Reemplaza 'certificados.miinstitucion.edu.pe' con tu dominio real
PUBLIC_VERIFICATION_BASE_URL=https://verificadorcertificados.tecnoeducap.com/v
CORS_ORIGINS=https://verificadorcertificados.tecnoeducap.com/

# 4. Conexión Frontend -> Backend API
VITE_API_URL=https://verificadorcertificados.tecnoeducap.com/api/v1
